# Firebase Console > Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Optional: InsureX backend origin (no trailing /api/v1), e.g. http://localhost:4000.
# When unset, admin pages keep using built-in demo data and agent sign-in is disabled.
VITE_API_BASE_URL=

# Server-only settings. Keep these out of VITE_* variables.
FIREBASE_API_KEY=your-firebase-web-api-key
# Comma-separated Super Admin emails. Leave empty to allow any verified Google account.
AUTH_ADMIN_EMAILS=
AUTH_SESSION_SECRET=generate-a-32-character-or-longer-secret# Super Admin password sign-in (same values as backend/.env). Any ID + the password.
# The first ID containing "@" is the admin's email.
ADMIN_LOGIN_IDS=
ADMIN_PASSWORD=
