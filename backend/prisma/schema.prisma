// InsureX Prime — PostgreSQL schema.
// Money is stored as DECIMAL; dates without a time component use DATE.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InsuranceType {
  HEALTH
  MOTOR
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum PremiumFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  DUE
  PAID
  FAILED
  REFUNDED
}

enum SoldPolicyStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  BANK_TRANSFER
  CHEQUE
}

/// A person who can sign in. Identity comes from Firebase; role is decided here.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Null until the user's first Firebase sign-in links the account.
  firebaseUid        String?    @unique
  /// Stored lowercase. Also the agent's contact email (not duplicated on Agent).
  email              String     @unique
  role               Role
  status             UserStatus @default(ACTIVE)
  /// scrypt hash for agent password sign-in. Null until a password is issued.
  passwordHash       String?
  /// Set when a temporary password is issued; cleared once the user picks their own.
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  agent         Agent?
  auditLogs     AuditLog[]
  agentSessions AgentSession[]

  @@index([role])
  @@map("users")
}

model Agent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @unique @db.Uuid
  agentCode String      @unique
  fullName  String
  phone     String
  address   String?
  joinedAt  DateTime    @default(now()) @db.Date
  status    AgentStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  customers    Customer[]
  soldPolicies SoldPolicy[]

  @@index([status])
  @@index([fullName])
  @@map("agents")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  customerCode        String         @unique
  fullName            String
  dateOfBirth         DateTime?      @db.Date
  gender              Gender?
  phone               String
  email               String?
  address             String?
  city                String?
  state               String?
  nomineeName         String?
  nomineeRelationship String?
  assignedAgentId     String?        @db.Uuid
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedAgent Agent?       @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict)
  soldPolicies  SoldPolicy[]

  @@index([assignedAgentId])
  @@index([status])
  @@index([fullName])
  @@index([createdAt])
  @@map("customers")
}

/// A product in the catalog. Only ACTIVE policies can be sold by agents.
model Policy {
  id               String           @id @default(uuid()) @db.Uuid
  policyCode       String           @unique
  policyName       String
  insuranceType    InsuranceType
  description      String           @default("")
  coverageAmount   Decimal          @db.Decimal(14, 2)
  premium          Decimal          @db.Decimal(12, 2)
  premiumFrequency PremiumFrequency
  durationMonths   Int
  eligibility      String           @default("")
  benefits         String[]
  terms            String           @default("")
  /// Health- or motor-specific fields, validated by the API per insuranceType.
  categoryDetails  Json?
  status           PolicyStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  soldPolicies SoldPolicy[]

  @@index([insuranceType, status])
  @@index([status])
  @@index([policyName])
  @@map("policies")
}

model SoldPolicy {
  id            String           @id @default(uuid()) @db.Uuid
  policyNumber  String           @unique
  policyId      String           @db.Uuid
  customerId    String           @db.Uuid
  agentId       String           @db.Uuid
  /// Premium agreed at sale time; catalog prices can change later.
  premium       Decimal          @db.Decimal(12, 2)
  issueDate     DateTime         @db.Date
  expiryDate    DateTime         @db.Date
  paymentStatus PaymentStatus    @default(PENDING)
  policyStatus  SoldPolicyStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  policy   Policy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  receipts Receipt[]

  @@index([agentId, issueDate])
  @@index([agentId, expiryDate])
  @@index([customerId])
  @@index([policyId])
  @@index([issueDate])
  @@index([policyStatus])
  @@index([paymentStatus])
  @@map("sold_policies")
}

model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  receiptNumber String        @unique
  soldPolicyId  String        @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PAID)
  issuedAt      DateTime      @default(now())

  soldPolicy SoldPolicy @relation(fields: [soldPolicyId], references: [id], onDelete: Restrict)

  @@index([soldPolicyId])
  @@index([issuedAt])
  @@map("receipts")
}

/// A signed-in agent browser session. Only a SHA-256 hash of the cookie token is stored.
model AgentSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("agent_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  /// Non-sensitive context only (codes, changed field names). Never tokens or secrets.
  metadata  Json?
  ipAddress String?
  requestId String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
